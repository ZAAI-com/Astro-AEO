{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaai.com/astro-aeo/schema/graph-report-v1.schema.json",
  "title": "Astro-AEO graph-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "warnings",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "graph"
    },
    "warnings": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "types"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "property"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "property": {
            "type": "string"
          }
        }
      }
    }
  }
}

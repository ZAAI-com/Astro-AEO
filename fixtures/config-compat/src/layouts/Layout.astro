---
const { title, description, aeo, modified } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} | Compat Site</title>
    {description && <meta name="description" content={description} />}
    {aeo && <meta name="aeo" content={aeo} />}
    {modified && <meta property="article:modified_time" content={modified} />}
  </head>
  <body>
    <nav><a href="/">Home</a></nav>
    <main>
      <slot />
    </main>
    <footer>Chrome, excluded from the markdown.</footer>
  </body>
</html>

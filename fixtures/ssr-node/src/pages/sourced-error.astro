---
import Layout from '../layouts/Layout.astro';
import { defineAeoPage } from 'astro-aeo/page';
import { AeoPage } from 'astro-aeo/components';

const fail = Astro.url.searchParams.get('fail') === '1';
if (fail) Astro.response.status = 500;
const aeoPage = defineAeoPage({
  markdown: '# Private error source\n\nThis must stay inside the representation pipeline.',
  title: 'Sourced Error',
});
---
<Layout title="Sourced Error" description="An authored error page.">
  {fail && <AeoPage {...aeoPage} />}
  <h1>Sourced Error</h1>
  <p>{fail ? 'Rendered error body.' : 'Healthy source page body.'}</p>
</Layout>

---
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';

// The shared build/runtime enrichment pass owns precedence and deduplication.
// Keeping the component as one inert, escaped marker lets that pass make the
// same decision for prerendered and on-demand pages without rewriting unrelated
// authored head bytes.
const props = Astro.props ?? {};
---
<script
  type="application/vnd.astro-aeo-head+json"
  data-astro-aeo-head
  is:inline
  set:html={serializeJsonLd(props)}
/>

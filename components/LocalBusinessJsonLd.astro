---
import { createEntity } from '../src/schema.js';
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';
import { warnGoogleSchema } from '../src/core/schema-google.js';

type Props = import('./index.js').LocalBusinessJsonLdProps;
const { entity, eligibility = 'schema' } = Astro.props;
const jsonLd = { '@context': 'https://schema.org', ...createEntity({ ...entity, '@type': 'LocalBusiness' }) };
if (entity) warnGoogleSchema(jsonLd, eligibility, { documentUrl: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href, explicitType: 'LocalBusiness' });
---

{entity && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

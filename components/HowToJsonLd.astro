---
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';
import { warnGoogleSchema } from '../src/core/schema-google.js';
import { createHowTo } from '../src/schema.js';

type Props = import('./index.js').HowToJsonLdProps;

/**
 * HowTo JSON-LD. Provide a name and ordered steps.
 * @typedef {{ name: string; text: string; url?: string; image?: string }} HowToStep
 */
const { name, description, totalTime, steps = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  ...createHowTo({
    ...(name !== undefined && { name }),
    ...(description && { description }),
    ...(totalTime && { totalTime }),
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      ...(s.name !== undefined && { name: s.name }),
      ...(s.text !== undefined && { text: s.text }),
      ...(s.url && { url: s.url }),
      ...(s.image && { image: s.image }),
    })),
  }),
};
if (name && steps.length > 0) warnGoogleSchema(jsonLd, Astro.props.eligibility ?? 'schema', { documentUrl: Astro.url.href, explicitType: 'HowTo' });
---

{name && steps.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

---
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';
import { createFAQPage } from '../src/schema.js';

/**
 * FAQPage JSON-LD. Pass a list of question/answer pairs.
 * @typedef {{ question: string; answer: string }} FaqItem
 */
const { items = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  ...createFAQPage({
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      ...(item.question !== undefined && { name: item.question }),
      acceptedAnswer: {
        '@type': 'Answer',
        ...(item.answer !== undefined && { text: item.answer }),
      },
    })),
  }),
};
---

{items.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

---
import { resolveEntityId } from '../src/lib/entity-id.js';
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';
import { warnGoogleSchema } from '../src/core/schema-google.js';
import { createFAQPage } from '../src/schema.js';

type Props = import('./index.js').FaqJsonLdProps;

/**
 * FAQPage JSON-LD. Pass a list of question/answer pairs.
 *
 * `id` gives the FAQPage a stable `@id` so the graph and schema map can list it
 * instead of reporting an anonymous entity. A page-relative value such as `#faq`
 * resolves against this page's URL on the configured `site`; without a `site`
 * it is emitted as written. An `id` that does not parse, or that resolves to
 * the page URL itself (such as `""` or `"./"`), is omitted.
 * @typedef {{ question: string; answer: string }} FaqItem
 */
const { items = [], id } = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const entityId = resolveEntityId(id, pageUrl);

const jsonLd = {
  '@context': 'https://schema.org',
  ...createFAQPage({
    ...(entityId !== undefined && { '@id': entityId }),
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      ...(item.question !== undefined && { name: item.question }),
      acceptedAnswer: {
        '@type': 'Answer',
        ...(item.answer !== undefined && { text: item.answer }),
      },
    })),
  }),
};
if (items.length > 0) warnGoogleSchema(jsonLd, Astro.props.eligibility ?? 'schema', { documentUrl: Astro.url.href, explicitType: 'FAQPage' });
---

{items.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

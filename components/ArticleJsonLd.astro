---
import { serializeJsonLd } from '../src/lib/serialize-jsonld.js';
import { createArticle, createBlogPosting, createTechArticle } from '../src/schema.js';
import { warnGoogleSchema } from '../src/core/schema-google.js';

type Props = import('./index.js').ArticleJsonLdProps;

/**
 * Article JSON-LD for blog posts and dated content.
 * Authors accept names, Person/Organization objects, ID references, or arrays.
 */
const { headline, datePublished, dateModified, author, image, description, url,
  type = 'Article', publisher, keywords, inLanguage, eligibility = 'schema' } = Astro.props;

const canonical =
  url || (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname);

const builders = { Article: createArticle, BlogPosting: createBlogPosting, TechArticle: createTechArticle };
if (!Object.hasOwn(builders, type)) throw new TypeError('ArticleJsonLd type must be Article, BlogPosting, or TechArticle');
const builder = builders[type];
const authors = author ? (Array.isArray(author) ? author : [author])
  .map((entry) => typeof entry === 'string' ? { name: entry } : entry)
  .map((entry) => 'name' in entry ? ({
  '@type': entry['@type'] ?? 'Person',
  ...(entry.name !== undefined && { name: entry.name }),
  ...(entry.url && { url: entry.url }),
  ...(entry['@id'] && { '@id': entry['@id'] }),
  ...(entry.sameAs && { sameAs: entry.sameAs }),
}) : ({ '@id': entry['@id'] })) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  ...builder({
    ...(headline !== undefined && { headline }),
    ...(description && { description }),
    ...(datePublished && { datePublished }),
    ...(dateModified && { dateModified }),
    ...(image && { image }),
    mainEntityOfPage: canonical,
    ...(authors?.length ? { author: Array.isArray(author) ? authors : authors[0] } : {}),
    ...(publisher && { publisher }),
    ...(keywords && { keywords }),
    ...(inLanguage && { inLanguage }),
  }),
};
if (headline) warnGoogleSchema(jsonLd, eligibility, { documentUrl: new URL(canonical, Astro.url).href, explicitType: type });
---

{headline && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

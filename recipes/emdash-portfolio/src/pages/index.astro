---
import Base from '../layouts/Base.astro';
import { getEmDashCollection } from 'emdash';

const { entries: projects } = await getEmDashCollection('projects', { orderBy: { published_at: 'desc' }, limit: 4 });
---
<Base title="Studio" description="Selected work in brand, web, print, and photography.">
  <h1>Selected work</h1>
  {projects.map((project) => (
    <article>
      <h2><a href={`/work/${project.id}`}>{project.data.title}</a></h2>
      <p>{project.data.summary}</p>
    </article>
  ))}
</Base>

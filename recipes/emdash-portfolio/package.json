{
  "name": "astro-aeo-recipe-emdash-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "db:setup": "emdash seed seed/seed.json",
    "db:reset": "node -e \"for (const s of ['', '-journal', '-shm', '-wal']) require('node:fs').rmSync('data.db' + s, { force: true })\"",
    "audit": "astro-aeo audit dist/client"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.5",
    "astro-aeo": "^1.5.0",
    "emdash": "1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}

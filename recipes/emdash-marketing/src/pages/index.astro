---
import Base from '../layouts/Base.astro';
import MarketingBlocks from '../components/MarketingBlocks.astro';
import { getEmDashEntry, getSeoMeta } from 'emdash';

const { entry: page } = await getEmDashEntry('pages', 'home');
const seo = page ? getSeoMeta(page, { siteUrl: (Astro.site ?? new URL(Astro.url.origin)).href, path: '/' }) : null;
---
<Base title={seo?.title ?? 'Acme'} description={seo?.description} path="/">
  {page ? <MarketingBlocks value={page.data.content} /> : <h1>Acme</h1>}
</Base>

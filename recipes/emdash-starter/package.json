{
  "name": "astro-aeo-recipe-emdash-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "db:setup": "emdash seed seed/seed.json",
    "db:reset": "node -e \"for (const s of ['', '-journal', '-shm', '-wal']) require('node:fs').rmSync('data.db' + s, { force: true })\"",
    "audit": "astro-aeo audit dist/client"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.13",
    "astro-aeo": "^1.5.0",
    "emdash": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

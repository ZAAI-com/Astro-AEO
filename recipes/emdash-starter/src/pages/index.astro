---
import Base from '../layouts/Base.astro';
import { getEmDashCollection } from 'emdash';

const { entries: posts } = await getEmDashCollection('posts', { orderBy: { published_at: 'desc' }, limit: 5 });
---
<Base title="My Site" description="A site built with EmDash.">
  <h1>My Site</h1>
  <ul>{posts.map((post) => <li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>)}</ul>
</Base>

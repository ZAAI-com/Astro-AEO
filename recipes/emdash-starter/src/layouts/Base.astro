---
import { OrganizationJsonLd } from 'astro-aeo/components';

interface Props {
  title: string;
  description?: string;
  path?: string;
  robots?: string;
}

const { title, description, path = '/', robots = 'index, follow' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <OrganizationJsonLd name="My Site" url={site.href} />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/posts">Posts</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

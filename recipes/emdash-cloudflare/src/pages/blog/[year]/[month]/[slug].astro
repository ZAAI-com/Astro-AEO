---
import Base from '../../../../layouts/Base.astro';
import { ArticleJsonLd } from 'astro-aeo/components';
import { decodeSlug, getEmDashEntry, getSeoMeta } from 'emdash';
import { PortableText } from 'emdash/ui';
import { postPath } from '../../../../post-path.js';

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect('/404');
const { entry: post, error } = await getEmDashEntry('posts', slug);
if (error) return new Response('Unable to load post', { status: 500 });
if (!post) return Astro.redirect('/404');

// A post answers only at its dated URL; another year or month is a different page.
const path = postPath(post);
if (path !== `/blog/${Astro.params.year}/${Astro.params.month}/${slug}`) return Astro.redirect(path, 301);

const site = Astro.site ?? new URL(Astro.url.origin);
const seo = getSeoMeta(post, { siteTitle: 'Field Station', siteUrl: site.href, path });
---
<Base title={seo.title} description={seo.description} path={path} robots={seo.robots}>
  <article>
    <h1>{post.data.title}</h1>
    <p>{post.data.excerpt}</p>
    <PortableText value={post.data.content} />
  </article>
  <ArticleJsonLd
    headline={post.data.title}
    description={post.data.excerpt}
    datePublished={post.data.publishedAt?.toISOString()}
    dateModified={post.data.updatedAt?.toISOString()}
    author="Field Station"
    url={new URL(path, site).href}
  />
</Base>

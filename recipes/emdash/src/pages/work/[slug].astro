---
import Base from '../../layouts/Base.astro';
import { decodeSlug, getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';

const slug = decodeSlug(Astro.params.slug);
if (!slug) return new Response('Not found', { status: 404 });

const { entry: project, error } = await getEmDashEntry('projects', slug);
if (error) return new Response('Unable to load project', { status: 500 });
if (!project) return new Response('Not found', { status: 404 });

const path = `/work/${project.id}`;
---
<Base title={`${project.data.title} | Field Station`} description={project.data.summary} path={path}>
  <article>
    <h1>{project.data.title}</h1>
    <p>{project.data.summary}</p>
    <PortableText value={project.data.content} />
  </article>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getEmDashCollection } from 'emdash';

const { entries: projects, error } = await getEmDashCollection('projects', {
  orderBy: { published_at: 'desc' },
});
if (error) return new Response('Unable to load projects', { status: 500 });
---
<Base
  title="Work | Field Station"
  description="Portfolio case studies managed in EmDash."
  path="/work"
>
  <h1>Work</h1>
  {projects.map((project) => (
    <article>
      <h2><a href={`/work/${project.id}`}>{project.data.title}</a></h2>
      <p>{project.data.summary}</p>
    </article>
  ))}
</Base>

---
import { OrganizationJsonLd } from 'astro-aeo/components';

interface Props {
  title: string;
  description?: string;
  path?: string;
  robots?: string;
}

const { title, description = 'An EmDash-managed site published with Astro-AEO.', path = '/', robots = 'index, follow' } = Astro.props;
const site = Astro.site ?? new URL('https://recipe.example.com');
const canonical = new URL(path, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <OrganizationJsonLd name="Field Station" url={site.href} description="A marketing site with a blog and customer stories, managed in EmDash." />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/customers">Customers</a>
        <a href="/legal/privacy">Privacy</a>
        <a href="/_emdash/admin/">Admin</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { getEmDashCollection } from 'emdash';

const { entries: posts } = await getEmDashCollection('posts', { orderBy: { published_at: 'desc' }, limit: 5 });
---
<Base title="My Blog" description="Thoughts on building for the web.">
  <h1>My Blog</h1>
  <p>Thoughts on building for the web.</p>
  <h2>Recent posts</h2>
  <ul>
    {posts.map((post) => <li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>)}
  </ul>
</Base>

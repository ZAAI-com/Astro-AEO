{
  "name": "astro-aeo",
  "version": "1.6.0",
  "description": "Answer Engine Optimization for Astro: .md companion pages, llms.txt, llms-full.txt, robots.txt AI-bot policies, domain-profile.json, sitemap auto-wiring, JSON-LD components, a validator CLI, and one-line EmDash CMS support.",
  "type": "module",
  "license": "MIT",
  "author": "ZAAI (https://zaai.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZAAI-com/Astro-AEO.git"
  },
  "homepage": "https://zaai.com/astro-aeo/",
  "bugs": {
    "url": "https://github.com/ZAAI-com/Astro-AEO/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./components": {
      "types": "./components/index.d.ts",
      "default": "./components/index.js"
    },
    "./page": {
      "types": "./src/page.d.ts",
      "default": "./src/page.js"
    },
    "./extract": {
      "types": "./src/extract.d.ts",
      "default": "./src/extract.js"
    },
    "./content": {
      "types": "./src/content.d.ts",
      "default": "./src/content.js"
    },
    "./starlight": {
      "types": "./src/starlight.d.ts",
      "default": "./src/starlight.js"
    },
    "./starlight/route-data": "./src/starlight/route-data.js",
    "./emdash": {
      "types": "./src/emdash.d.ts",
      "default": "./src/emdash.js"
    },
    "./emdash/catalog": "./src/emdash/catalog.js",
    "./edge": {
      "types": "./src/edge.d.ts",
      "default": "./src/edge.js"
    },
    "./edge/cloudflare": {
      "types": "./src/edge/cloudflare.d.ts",
      "default": "./src/edge/cloudflare.js"
    },
    "./edge/netlify": {
      "types": "./src/edge/netlify.d.ts",
      "default": "./src/edge/netlify.js"
    },
    "./edge/vercel": {
      "types": "./src/edge/vercel.d.ts",
      "default": "./src/edge/vercel.js"
    },
    "./mdx": {
      "types": "./src/adapters.d.ts",
      "default": "./src/adapters/mdx.js"
    },
    "./defuddle": {
      "types": "./src/adapters.d.ts",
      "default": "./src/adapters/defuddle.js"
    },
    "./middleware": {
      "types": "./src/runtime/middleware.d.ts",
      "default": "./src/runtime/middleware.js"
    },
    "./schema": {
      "types": "./src/schema.d.ts",
      "default": "./src/schema.js"
    },
    "./schema.json": "./schema/astro-aeo.schema.json",
    "./audit-report.schema.json": "./schema/audit-report-v1.schema.json",
    "./package.json": "./package.json",
    "./analytics": {
      "types": "./src/analytics.d.ts",
      "default": "./src/analytics.js"
    },
    "./analytics-event.schema.json": "./schema/analytics-event-v1.schema.json",
    "./rag-record.schema.json": "./schema/rag-record-v1.schema.json",
    "./rag-index.schema.json": "./schema/rag-index-v1.schema.json"
  },
  "bin": {
    "astro-aeo": "./bin/astro-aeo.js"
  },
  "files": [
    "src",
    "components",
    "bin",
    "cli",
    "schema",
    "README.md",
    "LICENSE",
    "!**/*.test.js",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.19.5"
  },
  "packageManager": "pnpm@11.17.0",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "aeo",
    "geo",
    "seo",
    "llms.txt",
    "llms",
    "answer-engines",
    "generative-engine-optimization",
    "robots.txt",
    "json-ld",
    "schema.org",
    "markdown",
    "emdash",
    "cms"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0",
    "@mdx-js/mdx": "^3.1.1",
    "astro": ">=5.0.0",
    "defuddle": "^0.19.2",
    "emdash": ">=1.0.1",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "emdash": {
      "optional": true
    },
    "@mdx-js/mdx": {
      "optional": true
    },
    "defuddle": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "linkedom": "^0.18.13",
    "schema-dts": "^2.0.0",
    "turndown": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/netlify": "8.2.6",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "0.42.4",
    "@astrojs/vercel": "11.0.11",
    "@changesets/cli": "^2.31.1",
    "@deno/astro-adapter": "0.6.0",
    "@emdash-cms/cloudflare": "1.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/turndown": "^5.0.6",
    "astro": "^7.3.5",
    "astro-aeo": "link:.",
    "defuddle": "^0.19.4",
    "emdash": "1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-floor": "npm:typescript@5.5.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:adapters": "pnpm run test:adapters:build && pnpm run test:adapters:runtime",
    "test:adapters:build": "vitest run --config vitest.adapters-build.config.js",
    "test:adapters:runtime": "vitest run --config vitest.adapters-runtime.config.js",
    "test:compat:node": "node scripts/test-node-server-compat.mjs",
    "test:edge": "vitest run --config vitest.edge.config.js",
    "test:recipes": "vitest run --config vitest.recipes.config.js",
    "test:dev": "vitest run --config vitest.dev.config.js",
    "test:ssr": "vitest run --config vitest.ssr.config.js",
    "test:trailing": "node scripts/test-node-server-compat.mjs --trailing-matrix",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:types": "node node_modules/typescript-floor/bin/tsc --noEmit -p fixtures/types-consumer/tsconfig.json",
    "schema:generate": "node scripts/generate-schema.mjs",
    "schema:check": "node scripts/check-schema.mjs",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changesets.mjs --since origin/main",
    "benchmark": "node --expose-gc benchmarks/run.mjs",
    "benchmark:check": "node --expose-gc benchmarks/run.mjs --enforce",
    "benchmark:audit": "node benchmarks/audit.mjs --enforce",
    "benchmark:baseline": "node scripts/update-benchmark-baseline.mjs",
    "indexnow:smoke": "node scripts/indexnow-network-smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "demo:dev": "cd fixtures/demo && astro dev",
    "demo:build": "astro build --root fixtures/demo",
    "demo:validate": "node bin/astro-aeo.js validate fixtures/demo/dist"
  }
}

{
  "name": "astro-aeo",
  "version": "1.1.0",
  "description": "Answer Engine Optimization for Astro: .md companion pages, llms.txt, llms-full.txt, robots.txt AI-bot policies, domain-profile.json, sitemap auto-wiring, JSON-LD components, and a validator CLI.",
  "type": "module",
  "license": "MIT",
  "author": "ZAAI (https://zaai.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZAAI-com/Astro-AEO.git"
  },
  "homepage": "https://zaai.com/astro-aeo/",
  "bugs": {
    "url": "https://github.com/ZAAI-com/Astro-AEO/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./components": {
      "types": "./components/index.d.ts",
      "default": "./components/index.js"
    },
    "./page": {
      "types": "./src/page.d.ts",
      "default": "./src/page.js"
    },
    "./extract": {
      "types": "./src/extract.d.ts",
      "default": "./src/extract.js"
    },
    "./middleware": {
      "types": "./src/runtime/middleware.d.ts",
      "default": "./src/runtime/middleware.js"
    },
    "./schema.json": "./schema/astro-aeo.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "astro-aeo": "./bin/astro-aeo.js"
  },
  "files": [
    "src",
    "components",
    "bin",
    "cli",
    "schema",
    "README.md",
    "LICENSE",
    "!**/*.test.js",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.19.5"
  },
  "packageManager": "pnpm@11.17.0",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "aeo",
    "geo",
    "seo",
    "llms.txt",
    "llms",
    "answer-engines",
    "generative-engine-optimization",
    "robots.txt",
    "json-ld",
    "schema.org",
    "markdown"
  ],
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/netlify": "8.1.3",
    "@astrojs/node": "^11.0.3",
    "@astrojs/vercel": "11.0.4",
    "@changesets/cli": "^2.29.8",
    "@deno/astro-adapter": "0.6.0",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "astro": "^7.1.3",
    "astro-aeo": "link:.",
    "typescript": "^7.0.2",
    "typescript-floor": "npm:typescript@5.5.4",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:adapters": "pnpm run test:adapters:build && pnpm run test:adapters:runtime",
    "test:adapters:build": "vitest run --config vitest.adapters-build.config.js",
    "test:adapters:runtime": "vitest run --config vitest.adapters-runtime.config.js",
    "test:dev": "vitest run --config vitest.dev.config.js",
    "test:ssr": "vitest run --config vitest.ssr.config.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:types": "node node_modules/typescript-floor/bin/tsc --noEmit -p fixtures/types-consumer/tsconfig.json",
    "schema:generate": "node scripts/generate-schema.mjs",
    "schema:check": "node scripts/check-schema.mjs",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changesets.mjs --since origin/main",
    "benchmark": "node --expose-gc benchmarks/run.mjs",
    "benchmark:check": "node --expose-gc benchmarks/run.mjs --enforce",
    "benchmark:baseline": "node scripts/update-benchmark-baseline.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "demo:dev": "astro dev --root fixtures/demo",
    "demo:build": "astro build --root fixtures/demo",
    "demo:validate": "node bin/astro-aeo.js validate fixtures/demo/dist"
  }
}
